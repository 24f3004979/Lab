   "source": [
    "# Torch fundamentals with numpy workflow\n",
    "import torch\n",
    "\n",
    "matrix = [[1,2],[2,3]]\n",
    "tensor1 = torch.tensor(matrix)\n",
    "\n",
    "tensor2 = tensor1 * 3\n",
    "\n",
    "stacked = torch.stack([tensor1, tensor2])\n",
    "cated = torch.cat([tensor1, tensor2])\n",
    "\n",
    "print(stacked.shape)\n",
    "print(cated.shape)\n"
   ]
  }
 ],
